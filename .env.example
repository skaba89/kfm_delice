# ═══════════════════════════════════════════════════════════════
#  KFM Delice — Environment Variables Template
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# ── DATABASE ───────────────────────────────────────────────────
# SQLite for dev, PostgreSQL for prod
DATABASE_URL=file:./db/custom.db
# DATABASE_URL=postgresql://user:password@localhost:5432/kfm_delice

# ── AUTH / JWT ─────────────────────────────────────────────────
# REQUIRED! Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── APP URL ────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000

# ── TENANT STRATEGY ────────────────────────────────────────────
# "slug-header" = use slug from header/subdomain; "single" = single tenant
TENANT_STRATEGY=slug-header

# ── SMTP (Email) ───────────────────────────────────────────────
# Leave empty to use console fallback in dev.
# For prod, use Resend (preferred) or SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KFM Delice <noreply@kfm-delice.com>"

# ── EMAIL: Resend (preferred over SMTP) ────────────────────────
# Get API key at https://resend.com
RESEND_API_KEY=

# ── PUSH NOTIFICATIONS (Web Push) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kfm-delice.com

# ── WEBHOOK SECRET (payment callbacks) ─────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# ── PAYMENTS: Orange Money ─────────────────────────────────────
# Register at https://developer.orange.com
ORANGE_ENVIRONMENT=sandbox
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_URL=https://api.orange.com

# ── PAYMENTS: MTN MoMo ─────────────────────────────────────────
# Register at https://momodeveloper.mtn.com/
MTN_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_API_URL=https://momodeveloper.mtn.com
MTN_MOMO_CALLBACK_URL=

# ── PAYMENTS: Wave ─────────────────────────────────────────────
# Contact Wave Business for API access
WAVE_API_KEY=
WAVE_API_URL=https://api.wave.com
