# ───────────────────────────────────────────────────────────────────
# Render Blueprint — KFM Delice (SQLite dev/staging)
# ───────────────────────────────────────────────────────────────────
# Quick-start Blueprint that uses SQLite (no external DB needed).
# The DB is wiped on every deploy, so only use this for demos.
#
# To use:
#   1. Push this file to your repo as render.yaml
#   2. In Render dashboard → New → Blueprint → pick this repo
#
# For production, use render.yaml (PostgreSQL) instead.
# ───────────────────────────────────────────────────────────────────
services:
  - type: web
    name: kfm-delice
    runtime: node
    plan: free
    branch: main
    buildCommand: bash render-build.sh
    startCommand: bash render-start.sh
    envVars:
      - key: NODE_ENV
        value: production
      - key: NEXT_TELEMETRY_DISABLED
        value: "1"
      - key: PORT
        value: 10000
      - key: HOSTNAME
        value: "0.0.0.0"
      - key: DATABASE_URL
        value: "file:./data/kfm-delice.db"
      - key: JWT_SECRET
        generateValue: true
      - key: NEXT_PUBLIC_SHOW_DEMO_CREDS
        value: "false"
