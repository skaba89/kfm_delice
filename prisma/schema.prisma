generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// SaaS Platform Owner — super-admin who manages all restaurants
// ────────────────────────────────────────────────────────────────
model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("super_admin") // super_admin, support
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Restaurant — central tenant entity
// ────────────────────────────────────────────────────────────────
model Restaurant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  tagline       String   @default("")
  description   String   @default("")
  phone         String   @default("")
  whatsapp      String   @default("")
  email         String   @default("")
  address       String   @default("")
  hours         String   @default("")
  rating        Float    @default(4.5)
  tables        Int      @default(20)
  deliveryFee   Int      @default(5000)
  minDelivery   Int      @default(15000)
  deliveryZones String   @default("Conakry:Kaloum:Dixinn:Matam:Matoto")
  // SaaS subscription fields
  plan          String   @default("free") // free, starter, pro, enterprise
  status        String   @default("active") // active, suspended, trial, cancelled
  trialEndsAt   String   @default("") // ISO date string
  currency      String   @default("GNF") // GNF, EUR, USD, XOF, etc.
  locale        String   @default("fr") // fr, en, etc.
  ownerEmail    String   @default("") // email of restaurant owner
  ownerName     String   @default("") // name of restaurant owner
  ownerPhone    String   @default("") // phone of restaurant owner
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  config      RestaurantConfig?
  admins      Admin[]
  customers   Customer[]
  menuItems     MenuItem[]
  reservations  Reservation[]
  orders        Order[]
  reviews       Review[]
  drivers       Driver[]
  staff         Staff[]
  invoices      Invoice[]
  quotes        Quote[]
  expenses      Expense[]
  payments      Payment[]
  loyaltyRewards LoyaltyReward[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]
}

// ────────────────────────────────────────────────────────────────
// RestaurantConfig — per-restaurant branding & UI customization
// ────────────────────────────────────────────────────────────────
model RestaurantConfig {
  id            String   @id @default(cuid())
  restaurantId  String   @unique
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Branding
  logo          String   @default("") // URL or path to logo
  heroImage     String   @default("") // URL or path to hero image
  primaryColor  String   @default("#ea580c") // Tailwind orange-600 default
  accentColor   String   @default("#f97316") // Tailwind orange-500 default
  fontFamily    String   @default("Inter") // CSS font family
  // Menu categories (JSON array: [{id, name}])
  menuCategories String  @default("[]")
  // Features toggle (JSON object)
  features      String   @default("{}")
  // Opening hours (JSON: {open: 11, close: 23, timezone: "Africa/Conakry"})
  openingHours  String   @default("{}")
  // Social links (JSON)
  socialLinks   String   @default("{}")
  // Custom domain (for white-label)
  customDomain  String   @default("")
  // SEO
  metaTitle     String   @default("")
  metaDescription String @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Admin — scoped to a restaurant
// ────────────────────────────────────────────────────────────────
model Admin {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String
  role              String   @default("admin") // admin, manager, staff
  status            String   @default("active") // active, inactive
  mustChangePassword Boolean @default(false) // force password change on first login
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([restaurantId])
}

// ────────────────────────────────────────────────────────────────
// Customer — scoped to a restaurant
// ────────────────────────────────────────────────────────────────
model Customer {
  id                String   @id @default(cuid())
  email             String
  password          String
  name              String
  phone             String   @default("")
  address           String   @default("")
  loyaltyPoints     Int      @default(0)
  totalOrders       Int      @default(0)
  totalSpent        Int      @default(0)
  status            String   @default("active") // active, inactive
  mustChangePassword Boolean @default(false) // force password change on first login
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  orders            Order[]
  reservations      Reservation[]
  reviews           Review[]
  loyaltyHistory    LoyaltyPointsHistory[]

  @@unique([email, restaurantId])
  @@index([restaurantId])
}

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  price        Int
  category     String
  image        String   @default("")
  badge        String   @default("")
  popular      Boolean  @default(false)
  available    Boolean  @default(true)
  order        Int      @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, category])
  @@index([restaurantId, available])
}

model Reservation {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  date         String
  time         String
  guests       Int      @default(2)
  zone         String   @default("interieur")
  notes        String   @default("")
  status       String   @default("pending")
  loyaltyPoint Int      @default(50)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([customerId])
}

model Order {
  id            String   @id @default(cuid())
  customerName  String   @default("")
  phone         String   @default("")
  items         String   // JSON string
  total         Int
  status        String   @default("pending") // pending, confirmed, preparing, ready, picking_up, delivering, delivered, cancelled
  orderType     String   @default("dine_in") // dine_in, takeaway, delivery
  paymentMethod String   @default("cash")
  paymentStatus String   @default("pending") // pending, processing, paid, failed, refunded
  deliveryAddress String @default("")
  deliveryFee   Int      @default(0)
  tableNumber   Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  note          String   @default("")
  estimatedDeliveryTime String @default("") // ISO string of estimated delivery
  driverLat      Float    @default(0) // driver live latitude
  driverLng      Float    @default(0) // driver live longitude
  driverEarning  Int      @default(0) // commission credited to driver on delivery
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  payments      Payment[]
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, orderType])
  @@index([restaurantId, createdAt])
  @@index([driverId])
  @@index([customerId])
}

model Driver {
  id                String   @id @default(cuid())
  email             String   @default("")
  password          String   @default("")
  name              String
  phone             String
  vehicle           String   @default("moto") // moto, velo, voiture
  status            String   @default("available") // available, busy, offline
  rating            Float    @default(5.0)
  totalDeliveries   Int      @default(0)
  zone              String   @default("Conakry")
  lat               Float    @default(0) // current latitude
  lng               Float    @default(0) // current longitude
  lastLocationUpdate DateTime @default(now()) // last GPS update
  currentOrderId    String   @default("") // current active order
  mustChangePassword Boolean @default(false) // force password change on first login
  // Driver earnings fields — same as PostgreSQL schema (Int on SQLite
  // is sufficient for dev DB; production uses BigInt)
  commissionRate    Float    @default(10)
  totalEarnings     Int      @default(0)
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders            Order[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([email, restaurantId])
  @@index([restaurantId, status])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  comment      String   @default("")
  date         String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([customerId])
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  phone        String   @default("")
  role         String   // cuisinier, serveur, barman, gerant, plongeur, securite, caissier
  salary       Int      @default(0)
  status       String   @default("active") // active, inactive, on_leave
  hireDate     String   @default("")
  notes        String   @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Invoice {
  id           String   @id @default(cuid())
  number       String
  customerName String
  customerPhone String @default("")
  items        String   // JSON string
  subtotal     Int
  tax          Int      @default(0)
  total        Int
  status       String   @default("pending") // pending, paid, cancelled, overdue
  dueDate      String   @default("")
  notes        String   @default("")
  orderId      String?  @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Quote {
  id            String   @id @default(cuid())
  number        String
  customerName  String
  customerPhone String  @default("")
  items         String   // JSON string
  subtotal      Int
  discount      Int      @default(0)
  total         Int
  status        String   @default("draft") // draft, sent, accepted, refused, expired
  validUntil    String   @default("")
  notes         String   @default("")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Expense {
  id           String   @id @default(cuid())
  description  String
  amount       Int
  category     String   // ingredients, utilities, rent, salary, equipment, transport, other
  date         String
  paidBy       String   @default("")
  notes        String   @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Int
  method          String   // cash, orange_money, mtn_money, card
  status          String   @default("pending") // pending, processing, paid, failed, refunded
  transactionRef  String   @default("") // External payment reference from Orange/MTN
  phone           String   @default("") // Customer phone for mobile money
  customerName    String   @default("")
  metadata        String   @default("{}") // JSON: additional payment data (OTP, receipt, etc.)
  paidAt          String   @default("")
  failedReason    String   @default("")
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([restaurantId, createdAt])
}

// ────────────────────────────────────────────────────────────────
// LoyaltyReward — redeemable rewards for customer loyalty points
// ────────────────────────────────────────────────────────────────
model LoyaltyReward {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  category     String   @default("discount") // discount, free_item, vip, cashback
  pointsCost   Int
  value        Int      @default(0) // monetary value or percentage
  active       Boolean  @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, active])
  @@index([restaurantId, category])
}

// ────────────────────────────────────────────────────────────────
// LoyaltyPointsHistory — audit log of all loyalty point movements
// ────────────────────────────────────────────────────────────────
model LoyaltyPointsHistory {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points      Int      // positive = earned, negative = redeemed
  type        String   // earned, redeemed, expired, adjusted
  description String   @default("")
  referenceId String   @default("") // order id, reward id, etc.
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────
// PushSubscription — Web Push API subscriptions for notifications
// ────────────────────────────────────────────────────────────────
model PushSubscription {
  id           String   @id @default(cuid())
  // Composite key: "<userType>:<userId>" (e.g. "admin:abc123")
  userKey      String
  userType     String   // admin, customer, driver, platform
  userId       String
  restaurantId String   @default("") // empty for platform admins
  endpoint     String   @unique // PushSubscription.endpoint (FCM/Mozilla URL)
  p256dhKey    String   // base64-encoded ECDH public key
  authKey      String   // base64-encoded auth secret
  userAgent    String   @default("") // browser identification
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userKey])
  @@index([userId, userType])
  @@index([restaurantId])
}

model StockItem {
  id            String   @id @default(cuid())
  name          String
  sku           String   @default("") // Optional stock-keeping unit / barcode
  category      String   @default("general") // e.g. ingredients, drinks, packaging, cleaning
  quantity      Float    @default(0)
  unit          String   @default("unité") // kg, L, unité, bouteille, sac, etc.
  minThreshold  Float    @default(0) // Low-stock alert threshold
  unitCost      Int      @default(0) // Purchase cost per unit (GNF)
  supplier      String   @default("")
  lastRestocked String   @default("") // ISO date string of last restock
  notes         String   @default("")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements     StockMovement[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([restaurantId, category])
  @@index([restaurantId, quantity])
}

model StockMovement {
  id            String   @id @default(cuid())
  stockItemId   String
  stockItem     StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type          String   // "in" (restock), "out" (consumption), "adjust" (correction), "waste"
  quantity      Float    // Positive number; direction is in `type`
  reason        String   @default("") // e.g. "Réappro Fournisseur X", "Sortie cuisine", "Casse"
  actor         String   @default("") // Who made the change (admin name, etc.)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([stockItemId])
  @@index([restaurantId, createdAt])
}
