generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String   @default("")
  description String   @default("")
  phone       String   @default("")
  whatsapp    String   @default("")
  email       String   @default("")
  address     String   @default("")
  hours       String   @default("")
  rating      Float    @default(4.5)
  tables      Int      @default(20)
  deliveryFee Int      @default(5000)
  minDelivery Int      @default(15000)
  deliveryZones String @default("Conakry:Kaloum:Dixinn:Matam:Matoto")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  menuItems     MenuItem[]
  reservations  Reservation[]
  orders        Order[]
  reviews       Review[]
  drivers       Driver[]
}

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  price        Int
  category     String
  image        String   @default("")
  badge        String   @default("")
  popular      Boolean  @default(false)
  available    Boolean  @default(true)
  order        Int      @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Reservation {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  date         String
  time         String
  guests       Int      @default(2)
  zone         String   @default("interieur")
  notes        String   @default("")
  status       String   @default("pending")
  loyaltyPoint Int      @default(50)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  customerName  String   @default("")
  phone         String   @default("")
  items         String   // JSON string
  total         Int
  status        String   @default("pending") // pending, preparing, ready, delivering, delivered, cancelled
  orderType     String   @default("dine_in") // dine_in, takeaway, delivery
  paymentMethod String   @default("cash")
  deliveryAddress String @default("")
  deliveryFee   Int      @default(0)
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Driver {
  id           String   @id @default(cuid())
  name         String
  phone        String
  vehicle      String   @default("moto") // moto, velo, voiture
  status       String   @default("available") // available, busy, offline
  rating       Float    @default(5.0)
  totalDeliveries Int   @default(0)
  zone         String   @default("Conakry")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  comment      String   @default("")
  date         String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}
