generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, manager, staff
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  phone           String   @default("")
  address         String   @default("")
  loyaltyPoints   Int      @default(0)
  totalOrders     Int      @default(0)
  totalSpent      Int      @default(0)
  status          String   @default("active") // active, inactive
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
  reservations    Reservation[]
  reviews         Review[]
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String   @default("")
  description String   @default("")
  phone       String   @default("")
  whatsapp    String   @default("")
  email       String   @default("")
  address     String   @default("")
  hours       String   @default("")
  rating      Float    @default(4.5)
  tables      Int      @default(20)
  deliveryFee Int      @default(5000)
  minDelivery Int      @default(15000)
  deliveryZones String @default("Conakry:Kaloum:Dixinn:Matam:Matoto")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  menuItems     MenuItem[]
  reservations  Reservation[]
  orders        Order[]
  reviews       Review[]
  drivers       Driver[]
  staff         Staff[]
  invoices      Invoice[]
  quotes        Quote[]
  expenses      Expense[]
  payments      Payment[]
}

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  price        Int
  category     String
  image        String   @default("")
  badge        String   @default("")
  popular      Boolean  @default(false)
  available    Boolean  @default(true)
  order        Int      @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, category])
  @@index([restaurantId, available])
}

model Reservation {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  date         String
  time         String
  guests       Int      @default(2)
  zone         String   @default("interieur")
  notes        String   @default("")
  status       String   @default("pending")
  loyaltyPoint Int      @default(50)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([customerId])
}

model Order {
  id            String   @id @default(cuid())
  customerName  String   @default("")
  phone         String   @default("")
  items         String   // JSON string
  total         Int
  status        String   @default("pending") // pending, confirmed, preparing, ready, picking_up, delivering, delivered, cancelled
  orderType     String   @default("dine_in") // dine_in, takeaway, delivery
  paymentMethod String   @default("cash")
  paymentStatus String   @default("pending") // pending, processing, paid, failed, refunded
  deliveryAddress String @default("")
  deliveryFee   Int      @default(0)
  tableNumber   Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  note          String   @default("")
  estimatedDeliveryTime String @default("") // ISO string of estimated delivery
  driverLat     Float    @default(0) // driver live latitude
  driverLng     Float    @default(0) // driver live longitude
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  payments      Payment[]
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, orderType])
  @@index([restaurantId, createdAt])
  @@index([driverId])
  @@index([customerId])
}

model Driver {
  id           String   @id @default(cuid())
  email        String   @default("") @unique
  password     String   @default("")
  name         String
  phone        String
  vehicle      String   @default("moto") // moto, velo, voiture
  status       String   @default("available") // available, busy, offline
  rating       Float    @default(5.0)
  totalDeliveries Int   @default(0)
  zone         String   @default("Conakry")
  lat          Float    @default(0) // current latitude
  lng          Float    @default(0) // current longitude
  lastLocationUpdate DateTime @default(now()) // last GPS update
  currentOrderId String @default("") // current active order
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, status])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  comment      String   @default("")
  date         String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([customerId])
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  phone        String   @default("")
  role         String   // cuisinier, serveur, barman, gerant, plongeur, securite, caissier
  salary       Int      @default(0)
  status       String   @default("active") // active, inactive, on_leave
  hireDate     String   @default("")
  notes        String   @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Invoice {
  id           String   @id @default(cuid())
  number       String
  customerName String
  customerPhone String @default("")
  items        String   // JSON string
  subtotal     Int
  tax          Int      @default(0)
  total        Int
  status       String   @default("pending") // pending, paid, cancelled, overdue
  dueDate      String   @default("")
  notes        String   @default("")
  orderId      String?  @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Quote {
  id            String   @id @default(cuid())
  number        String
  customerName  String
  customerPhone String  @default("")
  items         String   // JSON string
  subtotal      Int
  discount      Int      @default(0)
  total         Int
  status        String   @default("draft") // draft, sent, accepted, refused, expired
  validUntil    String   @default("")
  notes         String   @default("")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Expense {
  id           String   @id @default(cuid())
  description  String
  amount       Int
  category     String   // ingredients, utilities, rent, salary, equipment, transport, other
  date         String
  paidBy       String   @default("")
  notes        String   @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Int
  method          String   // cash, orange_money, mtn_money, card
  status          String   @default("pending") // pending, processing, paid, failed, refunded
  transactionRef  String   @default("") // External payment reference from Orange/MTN
  phone           String   @default("") // Customer phone for mobile money
  customerName    String   @default("")
  metadata        String   @default("{}") // JSON: additional payment data (OTP, receipt, etc.)
  paidAt          String   @default("")
  failedReason    String   @default("")
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([restaurantId, createdAt])
}
