// ───────────────────────────────────────────────────────────────────
// KFM Delice — PostgreSQL schema (PRODUCTION)
// ───────────────────────────────────────────────────────────────────
// Activated by `scripts/switch-schema.sh postgres` which copies this
// file to schema.prisma. To switch back to SQLite for local dev, run
// `scripts/switch-schema.sh sqlite` (the original schema is preserved
// as schema.sqlite.prisma).
//
// Key differences vs SQLite schema:
//   • provider = "postgresql"
//   • All monetary / counter Int fields → BigInt (GNF amounts can exceed
//     Int32 max of 2.1 billion; totalSpent / totalOrders / deliveryFee
//     etc. need headroom for a multi-tenant SaaS).
//   • Citext is NOT used to stay Prisma-portable; case-insensitive
//     email lookups are handled in application code (raw SQL `LOWER()`).
//   • Json fields typed as Json (not String) for native querying.
// ───────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// SaaS Platform Owner — super-admin who manages all restaurants
// ────────────────────────────────────────────────────────────────
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         String   @default("super_admin") // super_admin, support
  status       String   @default("active") // active, inactive
  // 2FA TOTP fields — secret is AES-256-GCM encrypted (Mission 7)
  twoFactorEnabled    Boolean  @default(false)
  twoFactorSecret     String?  // encrypted TOTP secret (AES-256-GCM)
  twoFactorBackupCodes String? // JSON array of hashed backup codes
  // ── Mission 7: session security ──
  tokenVersion        Int      @default(0) // bump to revoke all sessions
  mustChangePassword  Boolean  @default(false)
  loginAttempts       Int      @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

// ────────────────────────────────────────────────────────────────
// Account / Organization — SaaS customer account that owns restaurants
// ────────────────────────────────────────────────────────────────
model Account {
  id                       String   @id @default(cuid())
  name                     String
  ownerName                String   @default("")
  ownerEmail               String   @default("")
  ownerPhone               String   @default("")
  status                   String   @default("active") // active, trial, suspended, cancelled, over_quota
  plan                     String   @default("starter") // free, starter, pro, enterprise, custom

  maxRestaurants           Int      @default(1)
  maxSecondaryRestaurants  Int      @default(0)
  maxAdmins                Int      @default(3)
  maxUsers                 Int      @default(10)
  maxOrdersPerMonth        Int      @default(1000)

  contractStartDate        String   @default("")
  contractEndDate          String   @default("")
  trialEndsAt              String   @default("")
  commissionRate           Float    @default(0) // % commission plateforme (Reco 1)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  restaurants              Restaurant[]
  admins                   Admin[]
  auditLogs                AuditLog[]

  @@index([status])
  @@index([plan])
  @@index([ownerEmail])
}

// ────────────────────────────────────────────────────────────────
// Restaurant — central tenant entity
// ────────────────────────────────────────────────────────────────
model Restaurant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  tagline       String   @default("")
  description   String   @default("")
  phone         String   @default("")
  whatsapp      String   @default("")
  email         String   @default("")
  address       String   @default("")
  hours         String   @default("")
  rating        Float    @default(4.5)
  tables        Int      @default(20)
  deliveryFee   BigInt   @default(5000)
  minDelivery   BigInt   @default(15000)
  deliveryZones String   @default("Conakry:Kaloum:Dixinn:Matam:Matoto")
  deliveryRadiusKm Int @default(10) // max distance for driver assignment (km)
  loyaltyPointsRate Int @default(1) // points per 1000 GNF spent (configurable by admin)
  lat           Float    @default(9.5092) // restaurant GPS latitude
  lng           Float    @default(-13.7122) // restaurant GPS longitude
  // SaaS subscription fields
  plan          String   @default("free") // free, starter, pro, enterprise
  status        String   @default("active") // active, suspended, trial, cancelled
  trialEndsAt   String   @default("") // ISO date string
  currency      String   @default("GNF") // GNF, EUR, USD, XOF, etc.
  locale        String   @default("fr") // fr, en, etc.
  ownerEmail    String   @default("") // email of restaurant owner
  ownerName     String   @default("") // name of restaurant owner
  ownerPhone    String   @default("") // phone of restaurant owner
  // ── SaaS Account hierarchy ──
  accountId          String?  // nullable for backward compat
  account            Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parentRestaurantId String?  // null = principal, set = secondary
  type               String   @default("principal") // principal, secondary
  createdByAdminId   String?  // who created this restaurant
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  config      RestaurantConfig?
  admins      Admin[]
  customers   Customer[]
  menuItems     MenuItem[]
  reservations  Reservation[]
  orders        Order[]
  reviews       Review[]
  drivers       Driver[]
  staff         Staff[]
  invoices      Invoice[]
  quotes        Quote[]
  expenses      Expense[]
  payments      Payment[]
  loyaltyRewards LoyaltyReward[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]
  restaurantTables  RestaurantTable[]
  promoCodes        PromoCode[]
  chatMessages      ChatMessage[]
  loyaltyTiers      LoyaltyTier[]
  suppliers         Supplier[]
  // ── Mission 1/2/3/4/9 back-relations ──
  orderItems        OrderItem[]
  idempotencyKeys   IdempotencyKey[]
  paymentIdempotencyKeys PaymentIdempotencyKey[]
  promotionRedemptions PromotionRedemption[]
  webhookEvents     WebhookEvent[]
  customerFavorites CustomerFavorite[]

  @@index([status])
  @@index([plan])
}

// ────────────────────────────────────────────────────────────────
// RestaurantTable — physical tables with QR code token (Mission 11)
// ────────────────────────────────────────────────────────────────
model RestaurantTable {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name          String
  number        String
  capacity      Int        @default(4)
  zone          String     @default("")
  status        String     @default("available") // available, occupied, reserved, cleaning
  active        Boolean    @default(true)

  // ── QR token fields ──
  qrToken       String     @unique
  qrVersion     Int        @default(1)
  qrEnabled     Boolean    @default(true)
  qrGeneratedAt DateTime?
  lastScannedAt DateTime?
  scanCount     Int        @default(0)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders        Order[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([restaurantId, active])
  @@index([qrToken])
}

// ────────────────────────────────────────────────────────────────
// RestaurantConfig — per-restaurant branding & UI customization
// ────────────────────────────────────────────────────────────────
model RestaurantConfig {
  id            String   @id @default(cuid())
  restaurantId  String   @unique
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Branding
  logo          String   @default("") // URL or path to logo
  heroImage     String   @default("") // URL or path to hero image
  primaryColor  String   @default("#ea580c") // Tailwind orange-600 default
  accentColor   String   @default("#f97316") // Tailwind orange-500 default
  fontFamily    String   @default("Inter") // CSS font family
  // Menu categories (JSON array: [{id, name}])
  menuCategories Json   @default("[]")
  // Features toggle (JSON object)
  features      Json     @default("{}")
  // Opening hours (JSON: {open: 11, close: 23, timezone: "Africa/Conakry"})
  openingHours  Json     @default("{}")
  // Social links (JSON)
  socialLinks   Json     @default("{}")
  // Custom domain (for white-label)
  customDomain  String   @default("")
  // SEO
  metaTitle     String   @default("")
  metaDescription String @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────
// Admin — scoped to a restaurant
// ────────────────────────────────────────────────────────────────
model Admin {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String
  role              String   @default("admin") // admin, manager, staff, cashier, kitchen, delivery_manager, driver, host, accountant
  status            String   @default("active") // active, inactive
  mustChangePassword Boolean @default(false) // force password change on first login
  // ── Account security fields ──
  loginAttempts     Int      @default(0) // failed login attempts counter
  lockedUntil       DateTime? // null = not locked; set a future time to lock
  // ── Mission 7: session security ──
  tokenVersion      Int      @default(0) // bump to revoke all active sessions
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // ── SaaS Account fields ──
  accountId                  String?
  account                    Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  canCreateRestaurant        Boolean   @default(false)
  restaurantCreationLimit    Int       @default(0)
  restaurantsCreatedCount    Int       @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([restaurantId])
  @@index([email])
  @@index([accountId])
}

// ────────────────────────────────────────────────────────────────
// Customer — scoped to a restaurant
// ────────────────────────────────────────────────────────────────
model Customer {
  id                String   @id @default(cuid())
  email             String
  password          String
  name              String
  phone             String   @default("")
  address           String   @default("")
  loyaltyPoints     Int      @default(0)
  totalOrders       Int      @default(0)
  totalSpent        BigInt   @default(0)
  tier              String   @default("bronze")
  favoriteItemIds   String   @default("[]")
  birthday          String   @default("")
  referralCode      String   @default("")
  referredBy        String   @default("")
  status            String   @default("active") // active, inactive
  mustChangePassword Boolean @default(false) // force password change on first login
  // ── Account security fields ──
  loginAttempts     Int      @default(0)
  lockedUntil       DateTime?
  // ── Mission 7: session security ──
  tokenVersion      Int      @default(0) // bump to revoke all active sessions
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  orders            Order[]
  reservations      Reservation[]
  reviews           Review[]
  loyaltyHistory    LoyaltyPointsHistory[]
  favorites         CustomerFavorite[]

  @@unique([email, restaurantId])
  @@index([restaurantId])
  @@index([restaurantId, email])
}

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  price        BigInt
  category     String
  image        String   @default("")
  badge        String   @default("")
  popular      Boolean  @default(false)
  available    Boolean  @default(true)
  order        Int      @default(0)
  ingredientCost BigInt @default(0)
  stockItemId  String?  // link to StockItem for automatic stock decrement
  stockItem    StockItem? @relation("MenuItemStock", fields: [stockItemId], references: [id], onDelete: SetNull)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  favorites    CustomerFavorite[]
  orderItems   OrderItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, category])
  @@index([restaurantId, available])
  @@index([stockItemId])
}

model Reservation {
  id           String   @id @default(cuid())
  customerName String
  phone        String
  date         String
  time         String
  guests       Int      @default(2)
  zone         String   @default("interieur")
  notes        String   @default("")
  status       String   @default("pending")
  loyaltyPoint Int      @default(50)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([customerId])
}

model Order {
  id            String   @id @default(cuid())
  customerName  String   @default("")
  phone         String   @default("")
  items         Json     // JSON array of {id, name, price, qty}
  total         BigInt
  status        String   @default("pending") // pending, confirmed, preparing, ready, picking_up, delivering, delivered, cancelled
  orderType     String   @default("dine_in") // dine_in, takeaway, delivery
  paymentMethod String   @default("cash")
  paymentStatus String   @default("pending") // pending, processing, paid, failed, refunded
  deliveryAddress String @default("")
  deliveryFee   BigInt   @default(0)
  tableNumber   Int      @default(0)
  discount      BigInt   @default(0)
  tax           BigInt   @default(0)
  tip           BigInt   @default(0)
  platformCommission BigInt @default(0)
  note          String   @default("")
  estimatedDeliveryTime String @default("") // ISO string of estimated delivery
  driverLat      Float    @default(0) // driver live latitude
  driverLng      Float    @default(0) // driver live longitude
  driverEarning  BigInt   @default(0) // commission credited to driver on delivery
  // ── Delivery assignment system ──
  assignmentStatus String @default("none") // none, proposed, accepted, rejected, expired
  proposedToDriverId String? // which driver the delivery was proposed to
  proposedAt DateTime? // when the delivery was proposed
  deliveryLat Float @default(0) // customer delivery location lat
  deliveryLng Float @default(0) // customer delivery location lng
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  // ── Mission 11: table link + snapshot ──
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableNumberStr String   @default("") // snapshot of table.number (string)
  payments      Payment[]
  orderItems    OrderItem[]
  idempotencyKey IdempotencyKey?
  promotionRedemption PromotionRedemption?
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, orderType])
  @@index([restaurantId, createdAt])
  @@index([driverId])
  @@index([customerId])
  @@index([tableId])
}

model Driver {
  id                String   @id @default(cuid())
  email             String   @default("")
  password          String   @default("")
  name              String
  phone             String
  vehicle           String   @default("moto") // moto, velo, voiture
  status            String   @default("available") // available, busy, offline
  rating            Float    @default(5.0)
  totalDeliveries   Int      @default(0)
  zone              String   @default("Conakry")
  lat               Float    @default(0) // current latitude
  lng               Float    @default(0) // current longitude
  lastLocationUpdate DateTime @default(now()) // last GPS update
  currentOrderId    String   @default("") // current active order
  mustChangePassword Boolean @default(false) // force password change on first login
  // ── Account security fields ──
  loginAttempts     Int      @default(0)
  lockedUntil       DateTime?
  // Driver earnings fields
  commissionRate    Float    @default(10) // % commission on each delivery (default 10%)
  totalEarnings     BigInt   @default(0) // cumulative GNF earnings from all deliveries
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders            Order[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([email, restaurantId])
  @@index([restaurantId, status])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  comment      String   @default("")
  date         String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([customerId])
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  phone        String   @default("")
  role         String   // cuisinier, serveur, barman, gerant, plongeur, securite, caissier
  salary       BigInt   @default(0)
  status       String   @default("active") // active, inactive, on_leave
  hireDate     String   @default("")
  notes        String   @default("")
  weeklySchedule String @default("[]")
  totalHours   Float    @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Invoice {
  id           String   @id @default(cuid())
  number       String
  customerName String
  customerPhone String @default("")
  items        Json     // JSON array
  subtotal     BigInt
  tax          BigInt   @default(0)
  total        BigInt
  status       String   @default("pending") // pending, paid, cancelled, overdue
  dueDate      String   @default("")
  notes        String   @default("")
  orderId      String?  @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, status])
  @@index([number])
}

model Quote {
  id            String   @id @default(cuid())
  number        String
  customerName  String
  customerPhone String  @default("")
  items         Json     // JSON array
  subtotal      BigInt
  discount      BigInt   @default(0)
  total         BigInt
  status        String   @default("draft") // draft, sent, accepted, refused, expired
  validUntil    String   @default("")
  notes         String   @default("")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId, status])
  @@index([number])
}

model Expense {
  id           String   @id @default(cuid())
  description  String
  amount       BigInt
  category     String   // ingredients, utilities, rent, salary, equipment, transport, other
  date         String
  paidBy       String   @default("")
  notes        String   @default("")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, date])
  @@index([category])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          BigInt
  method          String   // cash, orange_money, mtn_money, card
  status          String   @default("pending") // pending, processing, paid, failed, refunded
  transactionRef  String   @default("") // External payment reference from Orange/MTN
  phone           String   @default("") // Customer phone for mobile money
  customerName    String   @default("")
  metadata        Json     @default("{}") // JSON: additional payment data (OTP, receipt, etc.)
  paidAt          String   @default("")
  failedReason    String   @default("")
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  paymentIdempotencyKeys PaymentIdempotencyKey[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([restaurantId, createdAt])
}

// ────────────────────────────────────────────────────────────────
// LoyaltyReward — redeemable rewards for customer loyalty points
// ────────────────────────────────────────────────────────────────
model LoyaltyReward {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  category     String   @default("discount") // discount, free_item, vip, cashback
  pointsCost   Int
  value        BigInt   @default(0) // monetary value or percentage
  active       Boolean  @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, active])
  @@index([restaurantId, category])
}

// ────────────────────────────────────────────────────────────────
// LoyaltyTier — configurable loyalty tiers per restaurant (Mission P3.8)
// ────────────────────────────────────────────────────────────────
model LoyaltyTier {
  id              String   @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String   // bronze, silver, gold, platinum
  label           String   @default("") // display label ("Bronze", "Argent", etc.)
  minSpent        BigInt   @default(0) // minimum totalSpent to reach this tier
  discountPercent Int      @default(0) // e.g. 5 = 5% discount on all orders
  freeDelivery    Boolean  @default(false)
  freeDish        Boolean  @default(false) // free dish per month
  color           String   @default("#cd7f32") // hex color for UI badge
  icon            String   @default("") // emoji or icon name
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, active])
}

// ────────────────────────────────────────────────────────────────
// PromoCode — discount codes for checkout (Mission P2.6)
// ────────────────────────────────────────────────────────────────
model PromoCode {
  id              String   @id @default(cuid())
  code            String   // BIENVENUE10, SUMMER20, etc.
  description     String   @default("")
  discountType    String   @default("percent") // percent, fixed
  discountValue   BigInt   @default(0) // 10 = 10% or 5000 = 5000 GNF
  minOrderTotal   BigInt   @default(0) // minimum cart total to apply
  maxUses         Int      @default(0) // 0 = unlimited
  usedCount       Int      @default(0)
  maxUsesPerUser  Int      @default(1) // per customer
  active          Boolean  @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions     PromotionRedemption[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([restaurantId, code])
  @@index([restaurantId, active])
  @@index([code])
}

// ────────────────────────────────────────────────────────────────
// LoyaltyPointsHistory — audit log of all loyalty point movements
// ────────────────────────────────────────────────────────────────
model LoyaltyPointsHistory {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points      Int      // positive = earned, negative = redeemed
  type        String   // earned, redeemed, expired, adjusted
  description String   @default("")
  referenceId String   @default("") // order id, reward id, etc.
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────
// PushSubscription — Web Push API subscriptions for notifications
// ────────────────────────────────────────────────────────────────
model PushSubscription {
  id           String   @id @default(cuid())
  // Composite key: "<userType>:<userId>" (e.g. "admin:abc123")
  userKey      String
  userType     String   // admin, customer, driver, platform
  userId       String
  restaurantId String   @default("") // empty for platform admins
  endpoint     String   @unique // PushSubscription.endpoint (FCM/Mozilla URL)
  p256dhKey    String   // base64-encoded ECDH public key
  authKey      String   // base64-encoded auth secret
  userAgent    String   @default("") // browser identification
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userKey])
  @@index([userId, userType])
  @@index([restaurantId])
}

model StockItem {
  id            String   @id @default(cuid())
  name          String
  sku           String   @default("") // Optional stock-keeping unit / barcode
  category      String   @default("general") // e.g. ingredients, drinks, packaging, cleaning
  quantity      Float    @default(0)
  unit          String   @default("unité") // kg, L, unité, bouteille, sac, etc.
  minThreshold  Float    @default(0)
  autoAlert     Boolean  @default(true)
  unitCost      Int      @default(0) // Purchase cost per unit (GNF)
  supplier      String   @default("")
  lastRestocked String   @default("") // ISO date string of last restock
  notes         String   @default("")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems     MenuItem[] @relation("MenuItemStock")
  movements     StockMovement[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([restaurantId, category])
  @@index([restaurantId, quantity])
}

model StockMovement {
  id            String   @id @default(cuid())
  stockItemId   String
  stockItem     StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type          String   // "in" (restock), "out" (consumption), "adjust" (correction), "waste"
  quantity      Float    // Positive number; direction is in `type`
  reason        String   @default("") // e.g. "Réappro Fournisseur X", "Sortie cuisine", "Casse"
  actor         String   @default("") // Who made the change (admin name, etc.)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([stockItemId])
  @@index([restaurantId, createdAt])
}

// ────────────────────────────────────────────────────────────────
// ChatMessage — internal restaurant chat (Mission P3.7)
// ────────────────────────────────────────────────────────────────
model ChatMessage {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  senderId      String   // admin id
  senderName    String   // snapshot
  senderRole    String   // admin, manager, staff, cashier, kitchen, delivery_manager, host, accountant
  content       String   // message text (max 1000 chars, validated server-side)
  createdAt     DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId])
}

// ────────────────────────────────────────────────────────────────
// Supplier — fournisseurs (Reco 14)
// ────────────────────────────────────────────────────────────────
model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactName   String   @default("")
  phone         String   @default("")
  email         String   @default("")
  address       String   @default("")
  category      String   @default("general")
  notes         String   @default("")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, category])
}

// ────────────────────────────────────────────────────────────────
// AuditLog — business audit trail for SaaS operations
// ────────────────────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actorType    String   // platform_admin, admin, customer, driver
  action       String   // account_create, quota_change, restaurant_create, etc.
  entityType   String   // Account, Restaurant, Admin, etc.
  entityId     String
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  restaurantId String?
  before       Json?
  after        Json?
  ipAddress    String   @default("")
  userAgent    String   @default("")
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([accountId])
  @@index([restaurantId])
  @@index([entityType])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────
// Mission 1: OrderItem — normalized line items (replaces JSON snapshot)
// ────────────────────────────────────────────────────────────────
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name          String   // snapshot at time of order
  unitPrice     BigInt   // snapshot at time of order (GNF)
  quantity      Int
  note          String   @default("")
  lineTotal     BigInt   // unitPrice * quantity
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
  @@index([restaurantId])
}

// ────────────────────────────────────────────────────────────────
// Mission 2: IdempotencyKey — atomic deduplication of order creation
// ────────────────────────────────────────────────────────────────
model IdempotencyKey {
  id            String   @id @default(cuid())
  key           String   // client-supplied idempotency key
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId       String?  @unique // the order created (null until order is committed)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId    String?  // null for anonymous orders
  requestHash   String   @default("") // SHA-256 of normalized payload (defense-in-depth)
  status        String   @default("pending") // pending, completed, failed
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId, key])
  @@index([restaurantId, status])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────
// Mission 3: PromotionRedemption — audit log of promo code usage
// ────────────────────────────────────────────────────────────────
model PromotionRedemption {
  id            String   @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId    String?  // null for anonymous orders
  customerFingerprint String @default("") // hash of phone+IP for anonymous abuse prevention
  discountAmount BigInt
  code          String   // snapshot of the code at redemption time
  createdAt     DateTime @default(now())

  @@unique([orderId]) // one promo per order
  @@index([promoCodeId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([customerId])
}

// ────────────────────────────────────────────────────────────────
// Mission 4: WebhookEvent — idempotent webhook processing
// ────────────────────────────────────────────────────────────────
model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   // stripe, orange_money, mtn_momo, wave
  providerEventId String   // unique event ID from provider (e.g. Stripe evt_...)
  eventType       String   // checkout.session.completed, etc.
  payload         Json     // raw event payload
  status          String   @default("pending") // pending, processed, failed, ignored
  processedAt     DateTime?
  errorMessage    String   @default("")
  restaurantId    String?
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, status])
  @@index([restaurantId, createdAt])
}

// ────────────────────────────────────────────────────────────────
// Mission 9: CustomerFavorite — normalized favorites (replaces JSON string)
// ────────────────────────────────────────────────────────────────
model CustomerFavorite {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([customerId, menuItemId])
  @@index([customerId])
  @@index([restaurantId])
}

// ────────────────────────────────────────────────────────────────
// Mission 7: RefreshToken — rotatable refresh tokens for JWT auth
// ────────────────────────────────────────────────────────────────
model RefreshToken {
  id            String   @id @default(cuid())
  tokenHash     String   @unique // SHA-256 of the refresh token
  userId        String
  userType      String   // admin, customer, driver, platform_admin
  restaurantId  String?
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedFrom   String?  // tokenHash this token was rotated from
  createdAt     DateTime @default(now())

  @@index([userId, userType])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────
// Mission 7: RevokedToken — explicit JWT revocation (jti-based)
// ────────────────────────────────────────────────────────────────
model RevokedToken {
  id            String   @id @default(cuid())
  jti           String   @unique // JWT ID claim
  userId        String
  userType      String
  expiresAt     DateTime // when the original JWT would have expired
  reason        String   @default("revoked")
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────
// Mission 1 (Phase 3): PaymentIdempotencyKey — prevents double-charging
// ────────────────────────────────────────────────────────────────
model PaymentIdempotencyKey {
  id            String   @id @default(cuid())
  key           String   // client-supplied idempotency key
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  paymentId     String?  @unique // the payment created (null until committed)
  payment       Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  orderId       String   // the order being paid
  requestHash   String   @default("") // SHA-256 of normalized payload
  status        String   @default("pending") // pending, completed, failed
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([restaurantId, key])
  @@index([restaurantId, status])
  @@index([expiresAt])
  @@index([orderId])
}

