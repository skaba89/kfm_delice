{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-schema.cjs && next dev -p 3000 2>&1 | tee dev.log",
    "build": "prisma generate && next build",
    "start": "node scripts/ensure-schema.cjs && node scripts/auto-seed.cjs; next start -p ${PORT:-3000} -H 0.0.0.0",
    "start:prod": "prisma migrate deploy && node scripts/auto-seed.cjs; next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bunx tsx prisma/seed.ts",
    "db:seed:reset": "bunx tsx prisma/seed.ts --reset",
    "db:seed:prod": "bunx tsx scripts/seed-production.ts",
    "db:seed:prod:dry": "bunx tsx scripts/seed-production.ts --dry-run",
    "db:seed:prod:yes": "bunx tsx scripts/seed-production.ts --yes",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:watch": "vitest",
    "e2e:saas": "python3 scripts/e2e-saas.py",
    "smoke": "bash scripts/smoke-render.sh",
    "ci:all": "npm run typecheck && npm run lint && npm run build && npm run test",
    "schema:status": "bash scripts/switch-schema.sh status",
    "schema:sqlite": "bash scripts/switch-schema.sh sqlite",
    "schema:postgres": "bash scripts/switch-schema.sh postgres",
    "e2e:live": "python3 scripts/e2e-live.py"
  },
