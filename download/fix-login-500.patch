+def _ensure_model_columns(eng, logger) -> None:
+    """
+    Safety net: add any columns that SQLAlchemy models declare but are missing
+    from the actual database tables.  This prevents 500 errors when Alembic
+    migrations are skipped due to Docker build cache (common on Render).
+
+    Uses information_schema to check existing columns, then ALTER TABLE ADD COLUMN
+    for each missing one.  Idempotent — safe to run on every startup.
+    """
+    # Define columns that must exist: (table, column, sqlalchemy_type, nullable)
+    required_columns = [
+        ("users", "extra_data", "TEXT", True),
+    ]
+
+    with eng.connect() as conn:
+        for table, column, col_type, nullable in required_columns:
+            # Check if column already exists
+            result = conn.execute(
+                sa.text(
+                    "SELECT column_name FROM information_schema.columns "
+                    "WHERE table_name = :table AND column_name = :column"
+                ),
+                {"table": table, "column": column},
+            ).fetchone()
+
+            if result is None:
+                try:
+                    null_sql = "NULL" if nullable else "NOT NULL"
+                    conn.execute(
+                        sa.text(
+                            f"ALTER TABLE {table} ADD COLUMN {column} {col_type} {null_sql}"
+                        )
+                    )
+                    conn.commit()
+                    logger.warning(
+                        "✓ Safety net: added missing column %s.%s (%s)",
+                        table, column, col_type,
+                    )
+                except Exception as e:
+                    conn.rollback()
+                    logger.warning(
+                        "Safety net: could not add column %s.%s — %s",
+                        table, column, e,
+                    )
+            else:
+                logger.info("✓ Column %s.%s exists", table, column)
+
+
