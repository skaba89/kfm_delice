# ───────────────────────────────────────────────────────────────────
# KFM Delice — Production Environment Template
# ───────────────────────────────────────────────────────────────────
# Copy this file to `.env` (local dev) or set these vars in your
# hosting provider's dashboard (Render, Railway, Vercel, Fly.io…).
#
# Lines marked [REQUIRED] must be set before `npm start`.
# Lines marked [OPTIONAL] have sensible defaults.
# Lines marked [PROD-ONLY] are only needed in production.
# ───────────────────────────────────────────────────────────────────

# ── DATABASE ───────────────────────────────────────────────────
# [REQUIRED] SQLite for local dev, PostgreSQL for production
# SQLite:      file:./data/kfm-delice.db
# PostgreSQL:  postgresql://USER:PASS@HOST:5432/DB?schema=public
DATABASE_URL="file:./data/kfm-delice.db"

# [OPTIONAL] Shadow DB used by `prisma migrate dev` (PostgreSQL only)
# DATABASE_SHADOW_URL="postgresql://USER:PASS@HOST:5432/DB_shadow?schema=public"

# ── AUTH / JWT ─────────────────────────────────────────────────
# [REQUIRED-PROD] Generate with: openssl rand -hex 64
JWT_SECRET="change-me-to-a-long-random-string-at-least-64-chars"

# [OPTIONAL] JWT token lifetime in seconds (default: 7 days)
JWT_EXPIRES_IN="604800"

# ── APP URL ────────────────────────────────────────────────────
# [REQUIRED-PROD] Public URL of the deployment (no trailing slash)
PUBLIC_APP_URL="https://kfm-delice.onrender.com"

# [OPTIONAL] Show demo credentials on login page
NEXT_PUBLIC_SHOW_DEMO_CREDS="false"

# ── TENANT STRATEGY ────────────────────────────────────────────
# [OPTIONAL] How the multi-tenant slug is resolved
# Options: slug-header (default) | subdomain | path | query
TENANT_STRATEGY="slug-header"

# ── SMTP (Email) ───────────────────────────────────────────────
# [OPTIONAL] If unset, emails are logged to console (dev mode).
# [REQUIRED-PROD] Real SMTP server for transactional emails.
# Examples:
#   SendGrid:        smtp.sendgrid.net / 587 / apikey / <your-api-key>
#   Mailgun:         smtp.mailgun.org / 587 / postmaster@... / <password>
#   Brevo:           smtp-relay.brevo.com / 587 / user@brevo.com / <smtp-key>
#   Amazon SES:      email-smtp.<region>.amazonaws.com / 587 / <smtp-user> / <smtp-pass>
#   Gmail (test):    smtp.gmail.com / 587 / you@gmail.com / <app-password>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"        # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="KFM Delice <noreply@kfm-delice.com>"

# ── RESEND (alternative to SMTP) ───────────────────────────────
# [OPTIONAL] If set, takes precedence over SMTP
# RESEND_API_KEY="re_xxxxxxxxxx"

# ── PUSH NOTIFICATIONS (Web Push API) ──────────────────────────
# [OPTIONAL] If unset, push notifications are disabled.
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kfm-delice.com"

# ── PAYMENTS: Orange Money (Guinée) ────────────────────────────
# [OPTIONAL] If unset, orange_money payment method returns "not configured"
ORANGE_MERCHANT_KEY=""
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
ORANGE_RETURN_URL="https://kfm-delice.onrender.com/api/payment/orange-return"

# ── PAYMENTS: MTN MoMo (Guinée) ────────────────────────────────
# [OPTIONAL] If unset, mtn_money payment method returns "not configured"
MTN_API_USER=""
MTN_API_KEY=""
MTN_SUBSCRIPTION_KEY=""
MTN_ENVIRONMENT="sandbox"   # sandbox | production

# ── FILE UPLOADS ───────────────────────────────────────────────
# [OPTIONAL] Local upload dir (default: ./uploads)
UPLOAD_DIR="./uploads"
# [OPTIONAL] Max upload size in MB (default: 5)
MAX_UPLOAD_MB="5"

# ── RATE LIMITING ──────────────────────────────────────────────
# [OPTIONAL] Auth endpoints (login, register)
AUTH_RATE_LIMIT="10"          # max attempts per window
AUTH_RATE_WINDOW_MS="60000"   # 1 minute
# [OPTIONAL] General API endpoints
API_RATE_LIMIT="60"
API_RATE_WINDOW_MS="60000"

# ── NODE / NEXT.JS ─────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
# [OPTIONAL] Suppress Next.js telemetry in production
NEXT_TELEMETRY_DISABLED="1"
