# ───────────────────────────────────────────────────────────────
# KFM Delice — Production Environment (.env.production.example)
# ───────────────────────────────────────────────────────────────
# Copy to .env.production and fill in your values.
# Used by docker-compose.yml for VPS deployment.
#
# Mission 6: ALL values below are REQUIRED for APP_MODE=production.
# The check-production-safety.cjs script will refuse to start if any
# required secret is missing.
# ───────────────────────────────────────────────────────────────

# ── APP MODE (Mission 6) ───────────────────────────────────────
# MUST be "production" for real deployments. Activates strict safety checks.
APP_MODE=production
NODE_ENV=production

# ── DATABASE (PostgreSQL REQUIRED in production) ───────────────
# SQLite is for dev/tests only. Production MUST use PostgreSQL.
DATABASE_URL=postgresql://kfm_delice:ChangeMeToAStrongPassword123!@localhost:5432/kfm_delice
POSTGRES_DB=kfm_delice
POSTGRES_USER=kfm_delice
POSTGRES_PASSWORD=ChangeMeToAStrongPassword123!

# ── SECRETS (all REQUIRED — generate with the commands below) ──
# JWT_SECRET: openssl rand -hex 32  (min 64 chars hex)
JWT_SECRET=GenerateARandom64CharSecretHere_abcdefghijklmnopqrstuvwxyz_0123456789

# TOTP_ENCRYPTION_KEY: openssl rand -base64 32  (AES-256-GCM key for 2FA secrets)
TOTP_ENCRYPTION_KEY=

# WEBHOOK_SECRET: openssl rand -hex 32  (HMAC for internal payment webhooks)
WEBHOOK_SECRET=

# SEED_TOKEN: openssl rand -hex 32  (required to call /api/seed)
SEED_TOKEN=

# ── DANGER FLAGS / PUBLIC ONBOARDING ──────────────────────────
ALLOW_AUTO_SEED=false
ALLOW_LOGIN_AUTO_SEED=false
ALLOW_PRISMA_DB_PUSH_FALLBACK=false
ALLOW_DEFAULT_TENANT=false
# Keep public signup disabled until domain/email/payment operational checks are complete.
ENABLE_PUBLIC_RESTAURANT_REGISTRATION=false
# Server-authoritative trial plan. Allowed: free, starter, pro. Never enterprise/custom.
PUBLIC_REGISTRATION_TRIAL_PLAN=starter
# Trial duration in days. Allowed: 1..60.
PUBLIC_REGISTRATION_TRIAL_DAYS=14
NEXT_PUBLIC_SHOW_DEMO_CREDS=false

# ── PUBLIC URL (MUST be HTTPS) ────────────────────────────────
PUBLIC_APP_URL=https://your-domain.com
TENANT_STRATEGY=slug-header

# ── RATE LIMITING (Redis/Upstash REQUIRED for multi-instance) ─
REDIS_URL=
# OR (alternative):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── EMAIL ──────────────────────────────────────────────────────
# Resend is preferred by the email service when configured; SMTP is the fallback.
# Financial dunning NEVER treats the development console fallback as delivered.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=KFM Delice <noreply@kfm-delice.com>

# ── SAAS BILLING / COLLECTION ──────────────────────────────────
# Secret used by POST /api/internal/platform-billing-cycle.
# The same value must also be configured as the GitHub Actions secret
# BILLING_CRON_SECRET together with RENDER_PUBLIC_BASE_URL so the daily
# billing-cycle workflow can call production.
BILLING_CRON_SECRET=

# Number of days between invoice issue date and due date (0..60).
BILLING_DUE_DAYS=7
# Maximum historical billing periods generated during one catch-up run (1..24).
BILLING_MAX_CATCH_UP=12

# IMPORTANT: keep access enforcement disabled during initial rollout.
# First verify existing receivables/subscription statuses in Platform Admin.
# When set to true, paused/cancelled billing blocks access and past_due blocks
# only after a real overdue invoice exceeds BILLING_ACCESS_GRACE_DAYS.
BILLING_ACCESS_ENFORCEMENT=false
# Commercial grace after the oldest overdue invoice due date (0..90 days).
BILLING_ACCESS_GRACE_DAYS=7

# Dunning emails are a separate opt-in. Keep false until a real Resend or SMTP
# provider and Account.ownerEmail data have been verified in production.
BILLING_DUNNING_ENABLED=false
# When access enforcement is active, send a warning this many days before grace ends (0..30).
BILLING_DUNNING_GRACE_WARNING_DAYS=3
# Maximum number of SaaS accounts evaluated per daily dunning run (1..500).
BILLING_DUNNING_BATCH_SIZE=100
# Allow a crashed "sending" claim to be retried after this many minutes (5..1440).
BILLING_DUNNING_CLAIM_TIMEOUT_MINUTES=30

# Separate grace period for SaaS contract end dates (0..90 days).
COMMERCIAL_CONTRACT_GRACE_DAYS=0

# ── PAYMENTS (all credentials REQUIRED for production payments) ─
# Stripe (cards — https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Orange Money (contact Orange Business Guinée)
ORANGE_MONEY_API_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_NUMBER=

# MTN MoMo (https://momodeveloper.mtn.com)
MTN_MOMO_API_URL=https://ericssondeveloperapi.portal.azure-api.net
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_API_KEY=

# Wave (contact Wave Business)
WAVE_API_URL=https://api.wave.com
WAVE_API_KEY=
WAVE_BUSINESS_ID=

# ── MONITORING ─────────────────────────────────────────────────
SENTRY_DSN=

# ── PUSH NOTIFICATIONS ────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kfm-delice.com

# ── JWT CONFIG (Mission 7) ────────────────────────────────────
JWT_ISSUER=kfm-delice
JWT_AUDIENCE=kfm-delice-users

# ── RATE LIMITS ────────────────────────────────────────────────
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_MS=60000
API_RATE_LIMIT=60
API_RATE_LIMIT_MS=60000
